# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_local_secret
APP_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# PostgreSQL and Redis
DATABASE_URL=postgresql://user:password@localhost:5432/vulcan
DIRECT_URL=postgresql://user:password@localhost:5432/vulcan
REDIS_URL=redis://localhost:6379
# Optional for Vercel web deployments: dispatch jobs to the private Redis-backed worker.
WORKER_DISPATCH_URL=https://your-worker.example.com
WORKER_DISPATCH_SECRET=replace_with_a_long_random_secret

# Email and AI
RESEND_API_KEY=replace_with_resend_key
DEEPSEEK_API_KEY=replace_with_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-flash
SCAN_CONFIDENCE_THRESHOLD=80

# GitHub
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret

# GitLab
GITLAB_CLIENT_ID=replace_with_gitlab_client_id
GITLAB_CLIENT_SECRET=replace_with_gitlab_client_secret
GITLAB_WEBHOOK_SECRET=replace_with_gitlab_webhook_secret

# Observability
SENTRY_DSN=replace_with_sentry_dsn
